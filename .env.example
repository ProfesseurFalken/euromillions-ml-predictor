# ===========================================
# EuroMillions ML Predictor - Configuration
# ===========================================
# Copy this file to .env and customize values

# Storage Configuration
STORAGE_DIR=./data
DB_URL=sqlite:///./data/draws.db
DATABASE_PATH=data/draws.db

# Scraping Configuration
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) Chrome/120.0
REQUEST_TIMEOUT=15
REQUEST_DELAY=1.0
MAX_RETRIES=3

# Model Configuration
MODEL_PATH=models/
RANDOM_STATE=42
MIN_TRAINING_ROWS=100

# UI Configuration
STREAMLIT_PORT=8501

# Feature Engineering
WINDOW_SIZES=10,20,50,100
DECAY_HALF_LIFE=15.0

# API (optional)
API_TOKEN=change-me-if-using-api

# Logging
LOG_LEVEL=INFO
